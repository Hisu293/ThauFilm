# Docker Compose ports
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5433
BACKEND_BIND_ADDRESS=0.0.0.0
POSTGRES_BIND_ADDRESS=0.0.0.0

# Public application URLs. On EC2, use its Elastic IP or domain.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Local PostgreSQL database
POSTGRES_DB=thaufilm
POSTGRES_USER=thaufilm
POSTGRES_PASSWORD=thaufilm

# Replace this outside local development (minimum 32 characters)
JWT_SECRET=replace-with-at-least-32-random-characters

# Browser origins allowed to call the backend directly.
# Add your LAN IP here when accessing the app from another device.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=onboarding@resend.dev

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=thau-film/community

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=java-06
STREAMING_PUBLIC_BASE_URL=https://java-06.s3.ap-southeast-1.amazonaws.com
FILE_UPLOAD_S3_PUBLIC_BASE_URL=
