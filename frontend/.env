# ============================================================
# API backend (Swagger: ${VITE_API_URL}/swagger-ui/index.html)
# Đổi link backend/swagger ở ĐÚNG 1 chỗ này — toàn bộ app dùng chung.
# api.js đọc VITE_API_URL làm baseURL cho mọi request.
# ============================================================
VITE_API_URL=https://courageous-serenity-production-6f7a.up.railway.app

# Bật mock API bằng MSW (chạy thử khi chưa có backend).
# Mặc định FALSE để dùng backend thật. Muốn bật mock trên máy mình: tạo file .env.local
# (đã được .gitignore) với dòng VITE_ENABLE_MOCK=true — không ảnh hưởng người khác khi push.
VITE_ENABLE_MOCK=false

VITE_GOOGLE_CLIENT_ID=429243335491-scnfecbtd48ihe0khob2i9ekqgvfv90f.apps.googleusercontent.com
