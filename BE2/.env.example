# ============================================================
# Backend Environment Variables (Railway Deployment)
# Copy this file to .env and fill in your values
# ============================================================

# ====== DATABASE (Supabase PostgreSQL) ======
# Get these from Supabase Dashboard > Settings > Database
DB_CONNECTION_URL=postgresql://postgres:PASSWORD@host:port/database?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://host:port/database?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_password

# ====== JWT ======
JWT_SECRET=your-very-long-secret-key-at-least-256-bits-long-for-hs256
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ====== GOOGLE OAUTH ======
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ====== CORS ======
# Add all allowed origins (frontend URLs)
# Example: https://your-app.railway.app,http://localhost:5173
CORS_ORIGINS=https://your-app.railway.app,http://localhost:5173

# ====== EMAIL (Optional - for sending tickets) ======
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ====== AI APIs (Optional) ======
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
